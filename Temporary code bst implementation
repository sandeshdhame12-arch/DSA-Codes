#include <iostream>
#include <queue>


using namespace std;

struct Node
{
    int data;
    Node *left;
    Node *right;

    Node(int value)
    {
        data = value;
        left = NULL;
        right = NULL;
    }
};

// Create binary tree recursively
Node* createTree()
{
    int value;

    cout << "Enter value (-1 for NULL): ";
    cin >> value;

    if (value == -1)
        return NULL;

    Node *temp = new Node(value);

    cout << "Enter left child of " << value << ":\n";
    temp->left = createTree();

    cout << "Enter right child of " << value << ":\n";
    temp->right = createTree();

    return temp;
}

// Insert node in a binary tree using level order
void insert(Node *&root, int value)
{
    if (value == -1)
    {
        cout << "Cannot insert -1 as a node value.\n";
        return;
    }

    Node *newNode = new Node(value);

    // If tree is empty
    if (root == NULL)
    {
        root = newNode;
        return;
    }

    queue<Node*> q;
    q.push(root);

    while (!q.empty())
    {
        Node *temp = q.front();
        q.pop();

        // Insert at first empty left position
        if (temp->left == NULL)
        {
            temp->left = newNode;
            return;
        }
        else
        {
            q.push(temp->left);
        }

        // Insert at first empty right position
        if (temp->right == NULL)
        {
            temp->right = newNode;
            return;
        }
        else
        {
            q.push(temp->right);
        }
    }
}

// Level order traversal display
void levelOrder(Node* root) {
    if (root == nullptr) {
        cout << "Tree is Empty.\n";
        return;
    }

    queue<Node*> q;
    q.push(root);

    while (!q.empty()) {
        Node* current = q.front();
        q.pop();

        cout << current->data << " ";

        if (current->left != nullptr) {
            q.push(current->left);
        }
        if (current->right != nullptr) {
            q.push(current->right);
        }
    }
    cout << "\n";
}

// Copy tree function
Node* copyTree(Node* root) {
    if (root == nullptr) {
        return nullptr;
    }

    Node* newNode = new Node(root->data);
    newNode->left = copyTree(root->left);
    newNode->right = copyTree(root->right);

    return newNode;
}

// Function to calculate the height of the tree
int findHeight(Node* root) {
    if (root == nullptr) {
        return -1; // Height of an empty tree is -1
    }

    int leftHeight = findHeight(root->left);
    int rightHeight = findHeight(root->right);

    return max(leftHeight, rightHeight) + 1;
}

// Function to display all leaf nodes (employees with no subordinates)
void printLeafNodes(Node* root) {
    if (root == nullptr) {
        return;
    }

    if (root->left == nullptr && root->right == nullptr) {
        cout << root->data << " ";
        return;
    }

    printLeafNodes(root->left);
    printLeafNodes(root->right);
}

int main() {
    Node* root = nullptr;
    Node* copyRoot = nullptr;
    int choice, val, n;

    do {
        cout << "\n==========================================";
        cout << "\n Employee Database Analysis using Binary Tree";
        cout << "\n==========================================";
        cout << "\n1. Insert Employee IDs";
        cout << "\n2. Display Original Tree (Level Order)";
        cout << "\n3. Copy Tree";
        cout << "\n4. Display Copied Tree (Level Order)";
        cout << "\n5. Find Height of Tree";
        cout << "\n6. Display Leaf Nodes";
        cout << "\n7. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter number of employee IDs to insert: ";
                cin >> n;
                for (int i = 0; i < n; i++) {
                    cout << "Enter Employee ID " << (i + 1) << ": ";
                    cin >> val;
                    insert(root, val); // Fixed: Removed assignment since insert returns void
                }
                break;

            case 2:
                cout << "\nOriginal Tree (Level Order): ";
                levelOrder(root);
                break;

            case 3:
                copyRoot = copyTree(root);
                cout << "\nTree Copied Successfully!\n";
                break;

            case 4:
                cout << "\nCopied Tree (Level Order): ";
                levelOrder(copyRoot);
                break;

            case 5:
                if (root == nullptr) {
                    cout << "\nTree is empty. Height is -1.\n";
                } else {
                    cout << "\nHeight of Tree: " << findHeight(root) << "\n";
                }
                break;

            case 6:
                if (root == nullptr) {
                    cout << "\nTree is empty.\n";
                } else {
                    cout << "\nLeaf Nodes (Employees with no subordinates): ";
                    printLeafNodes(root);
                    cout << "\n";
                }
                break;

            case 7:
                cout << "\nExiting Program...\n";
                break;

            default:
                cout << "\nInvalid Choice! Please enter a number between 1 and 7.\n";
        }
    } while (choice != 7);

    return 0;
}

