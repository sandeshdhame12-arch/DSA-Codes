#include<iostream>

class stack{

    private: int a[5];
    int top=-1;

    public:

    void push(int value){
        if (top==4)
        {
            printf("Stack is full\n");
            return;
        }
        top=top+1;
        a[top]=value;
        printf("%d is stored in stack\n", value);
        
    }

    void pop(){
        if(top==-1)
        {
            printf("Stack is Empty\n");
            return;
        }
        printf("%d is removed from stack\n",a[top]);
        top=top-1;
    }

    void display(){

        if (top==-1)
        {
            printf("Stack is empty\n");
            return;
        }
        
        for (int i =top; i >=0; i--)
        {
            printf("%d",a[i]);
        }
        printf("\n");
    }
};

int main(){
    stack s;
    s.push(20);
    s.push(40);
    s.push(60);
    s.push(80);
    s.push(100);

    s.pop();
    s.pop();
    
}


OUTPUT:
20 is stored in stack
40 is stored in stack
60 is stored in stack
80 is stored in stack
100 is stored in stack
100 is removed from stack
80 is removed from stack
